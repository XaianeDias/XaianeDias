# Chave do Claude (divide o roteiro em cenas, escreve/ajusta as falas). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Chave da OpenAI (gera as imagens das cenas e as vozes dos personagens). https://platform.openai.com
OPENAI_API_KEY=

# Opcionais
# PORT=3000
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_IMAGE_MODEL=gpt-image-1
